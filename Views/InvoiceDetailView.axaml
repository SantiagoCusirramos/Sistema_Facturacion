<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Sistema_Facturacion.Views.InvoiceDetailView"
             Background="#2E2E2E">
    
    <ScrollViewer>
        <StackPanel Margin="20">
            
            <!-- Header -->
            <Border Background="#4A90D9"
                    CornerRadius="8"
                    Padding="15"
                    Margin="0,0,0,20">
                <TextBlock Text="📄 INVOICE DETAIL"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"/>
            </Border>
            
            <!-- Status -->
            <Border Background="#333333"
                    CornerRadius="5"
                    Padding="10"
                    Margin="0,0,0,15">
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="#FFD700"
                           FontWeight="Bold"/>
            </Border>
            
            <!-- Invoice Info -->
            <Border Background="#404040"
                    CornerRadius="8"
                    Padding="15"
                    Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="📋 INVOICE INFORMATION"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,0,0,15"/>
                    
                    <Grid ColumnDefinitions="120,*,120,*" RowDefinitions="Auto,Auto,Auto">
                        
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="Invoice Number:" 
                                   Foreground="#CCCCCC"
                                   VerticalAlignment="Center"
                                   Margin="0,5"/>
                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   Text="{Binding InvoiceNumber}" 
                                   Foreground="#FFD700"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Margin="0,5"/>
                        
                        <TextBlock Grid.Row="0" Grid.Column="2"
                                   Text="Issue Date:" 
                                   Foreground="#CCCCCC"
                                   VerticalAlignment="Center"
                                   Margin="0,5"/>
                        <TextBlock Grid.Row="0" Grid.Column="3"
                                   Text="{Binding IssueDate}" 
                                   Foreground="White"
                                   VerticalAlignment="Center"
                                   Margin="0,5"/>
                        
                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="Customer:" 
                                   Foreground="#CCCCCC"
                                   VerticalAlignment="Center"
                                   Margin="0,5"/>
                        <TextBlock Grid.Row="1" Grid.Column="1"
                                   Text="{Binding Customer.Name}" 
                                   Foreground="White"
                                   VerticalAlignment="Center"
                                   Margin="0,5"/>
                        
                        <TextBlock Grid.Row="1" Grid.Column="2"
                                   Text="Status:" 
                                   Foreground="#CCCCCC"
                                   VerticalAlignment="Center"
                                   Margin="0,5"/>
                        <TextBlock Grid.Row="1" Grid.Column="3"
                                   Text="{Binding Status}" 
                                   Foreground="{Binding StatusColor}"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Margin="0,5"/>
                        
                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Text="Document ID:" 
                                   Foreground="#CCCCCC"
                                   VerticalAlignment="Center"
                                   Margin="0,5"/>
                        <TextBlock Grid.Row="2" Grid.Column="1"
                                   Text="{Binding Customer.DocumentId}" 
                                   Foreground="White"
                                   VerticalAlignment="Center"
                                   Margin="0,5"/>
                        
                    </Grid>
                </StackPanel>
            </Border>
            
            <!-- Products List -->
            <Border Background="#404040"
                    CornerRadius="8"
                    Padding="15"
                    Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="🛒 PRODUCTS"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,0,0,10"/>
                    
                    <ScrollViewer Height="250">
                        <ListBox ItemsSource="{Binding Details}"
                                 Background="#555555">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#4A4A4A"
                                            Margin="2"
                                            Padding="10">
                                        <Grid ColumnDefinitions="*,100,120,120">
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Product.Name}" 
                                                       Foreground="#FFD700"
                                                       FontWeight="Bold"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Quantity}" 
                                                       Foreground="White"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding UnitPrice, StringFormat='S/ {0:F2}'}" 
                                                       Foreground="#27AE60"
                                                       HorizontalAlignment="Right"/>
                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding Subtotal, StringFormat='S/ {0:F2}'}" 
                                                       Foreground="White"
                                                       HorizontalAlignment="Right"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                </StackPanel>
            </Border>
            
            <!-- Totals -->
            <Border Background="#404040"
                    CornerRadius="8"
                    Padding="15"
                    Margin="0,0,0,15">
                <StackPanel>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,5">
                        <TextBlock Grid.Column="0" Text="Subtotal:" Foreground="#CCCCCC" FontSize="14"/>
                        <TextBlock Grid.Column="1" Text="{Binding SubtotalFormatted}" 
                                   Foreground="White" FontSize="14"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,5">
                        <TextBlock Grid.Column="0" Text="IGV (18%):" Foreground="#CCCCCC" FontSize="14"/>
                        <TextBlock Grid.Column="1" Text="{Binding TaxFormatted}" 
                                   Foreground="White" FontSize="14"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,10">
                        <TextBlock Grid.Column="0" Text="TOTAL:" Foreground="#FFD700" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Grid.Column="1" Text="{Binding TotalFormatted}" 
                                   Foreground="#27AE60" FontSize="18" FontWeight="Bold"/>
                    </Grid>
                </StackPanel>
            </Border>
            
            <!-- Action Buttons -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Spacing="10">
                <Button Command="{Binding PrintCommand}"
                        Content="🖨️ PRINT INVOICE"
                        Background="#4A90D9"
                        Foreground="White"
                        Width="140"
                        Height="40"/>
                <Button Command="{Binding BackCommand}"
                        Content="🔙 BACK TO LIST"
                        Background="#95A5A6"
                        Foreground="White"
                        Width="140"
                        Height="40"/>
            </StackPanel>
            
        </StackPanel>
    </ScrollViewer>
</UserControl>
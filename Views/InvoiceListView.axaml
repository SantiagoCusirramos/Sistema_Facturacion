<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Sistema_Facturacion.Views.InvoiceListView"
             Background="#2E2E2E">
    
    <StackPanel Margin="20">
        
        <!-- Header -->
        <Border Background="#4A90D9"
                CornerRadius="8"
                Padding="15"
                Margin="0,0,0,20">
            <TextBlock Text="📄 INVOICE LIST"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"/>
        </Border>
        
        <!-- Status -->
        <Border Background="#333333"
                CornerRadius="5"
                Padding="10"
                Margin="0,0,0,15">
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="#FFD700"
                       FontWeight="Bold"/>
        </Border>
        
        <!-- Filters -->
<Border Background="#404040"
        CornerRadius="8"
        Padding="15"
        Margin="0,0,0,15">
    <StackPanel>
        <TextBlock Text="🔍 FILTERS"
                   FontWeight="Bold"
                   Foreground="White"
                   Margin="0,0,0,10"/>
        
        <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*">
            
            <TextBlock Grid.Column="0"
                       Text="Start Date (YYYY-MM-DD):" 
                       Foreground="White" 
                       VerticalAlignment="Center"
                       Margin="0,0,10,5"/>
            <TextBox Grid.Column="1"
                     Text="{Binding StartDate}"
                     Watermark="2024-01-01"
                     Background="#555555"
                     Foreground="White"
                     Margin="0,0,20,5"/>
            
            <TextBlock Grid.Column="2"
                       Text="End Date (YYYY-MM-DD):" 
                       Foreground="White" 
                       VerticalAlignment="Center"
                       Margin="0,0,10,5"/>
            <TextBox Grid.Column="3"
                     Text="{Binding EndDate}"
                     Watermark="2024-12-31"
                     Background="#555555"
                     Foreground="White"
                     Margin="0,0,20,5"/>
            
            <TextBlock Grid.Column="4"
                       Text="Customer:" 
                       Foreground="White" 
                       VerticalAlignment="Center"
                       Margin="0,0,10,5"/>
            <ComboBox Grid.Column="5"
                      ItemsSource="{Binding Customers}"
                      SelectedItem="{Binding FilterCustomer}"
                      Background="#555555"
                      Foreground="White"
                      Margin="0,0,0,5">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" Foreground="White"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            
        </Grid>
        
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0"
                    Spacing="10">
            <Button Command="{Binding LoadInvoicesCommand}"
                    Content="REFRESH"
                    Background="#4A90D9"
                    Foreground="White"
                    Height="35"
                    Width="100"/>
            <Button Command="{Binding FilterCommand}"
                    Content="APPLY FILTERS"
                    Background="#27AE60"
                    Foreground="White"
                    Height="35"
                    Width="120"/>
        </StackPanel>
    </StackPanel>
</Border>
        
        <!-- Invoices List -->
        <Border Background="#404040"
                CornerRadius="8"
                Padding="15"
                Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="📋 INVOICES"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="0,0,0,10"/>
                
                <ScrollViewer Height="350">
                    <ListBox ItemsSource="{Binding Invoices}"
                             SelectedItem="{Binding SelectedInvoice}"
                             Background="#555555">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#4A4A4A"
                                        Margin="2"
                                        Padding="10">
                                    <Grid ColumnDefinitions="50,140,180,100,100,90">
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Id}" 
                                                   Foreground="White"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding InvoiceNumber}" 
                                                   Foreground="#FFD700"
                                                   FontWeight="Bold"/>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Customer.Name}" 
                                                   Foreground="White"/>
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding IssueDate, StringFormat='dd/MM/yyyy'}" 
                                                   Foreground="#CCCCCC"/>
                                        <TextBlock Grid.Column="4"
                                                   Text="{Binding Total, StringFormat='S/ {0:F2}'}" 
                                                   Foreground="#27AE60"/>
                                        <TextBlock Grid.Column="5"
                                                   Text="{Binding Status}" 
                                                   Foreground="#FFD700"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>
                
                <TextBlock Text="{Binding Invoices.Count, StringFormat='Total: {0} invoices'}"
                           Foreground="White"
                           Margin="0,10,0,0"/>
            </StackPanel>
        </Border>
        
        <!-- Action Buttons -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Spacing="10">
            <Button Command="{Binding ViewDetailCommand}"
                    Content="🔍 VIEW DETAIL"
                    Background="#4A90D9"
                    Foreground="White"
                    Width="120"
                    Height="35"/>
            <Button Command="{Binding CancelInvoiceCommand}"
                    Content="❌ CANCEL INVOICE"
                    Background="#E74C3C"
                    Foreground="White"
                    Width="120"
                    Height="35"/>
        </StackPanel>
        
    </StackPanel>
</UserControl>
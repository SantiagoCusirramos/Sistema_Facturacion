<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Sistema_Facturacion.Views.ReportView"
             Background="#2E2E2E">
    
    <Grid RowDefinitions="Auto,Auto,*">
        
        <!-- Header -->
        <Border Grid.Row="0"
                Background="#4A90D9"
                CornerRadius="8"
                Padding="15"
                Margin="10,10,10,10">
            <TextBlock Text="📊 REPORTS DASHBOARD"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"/>
        </Border>
        
        <!-- Status -->
        <Border Grid.Row="1"
                Background="#333333"
                CornerRadius="5"
                Padding="10"
                Margin="10,0,10,10">
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="#FFD700"
                       FontWeight="Bold"/>
        </Border>
        
        <!-- Tab Control -->
        <TabControl Grid.Row="2"
                    Margin="10"
                    Background="#404040">
            
            <!-- Tab 1: Sales Report -->
            <TabItem Header="📈 SALES REPORT">
                <ScrollViewer>
                    <StackPanel Margin="15">
                        
                        <!-- Date Filters -->
                        <Border Background="#555555"
                                CornerRadius="8"
                                Padding="15"
                                Margin="0,0,0,15">
                            <Grid ColumnDefinitions="Auto,*,Auto,*,Auto">
                                
                                <TextBlock Grid.Column="0"
                                           Text="Start Date:" 
                                           Foreground="White" 
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding StartDateString}"
                                         Watermark="YYYY-MM-DD"
                                         Background="#666666"
                                         Foreground="White"
                                         Margin="0,0,20,0"
                                         Width="120"/>
                                
                                <TextBlock Grid.Column="2"
                                           Text="End Date:" 
                                           Foreground="White" 
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"/>
                                <TextBox Grid.Column="3"
                                         Text="{Binding EndDateString}"
                                         Watermark="YYYY-MM-DD"
                                         Background="#666666"
                                         Foreground="White"
                                         Margin="0,0,20,0"
                                         Width="120"/>
                                
                                <Button Grid.Column="4"
                                        Command="{Binding GenerateSalesReportCommand}"
                                        Content="GENERATE"
                                        Background="#27AE60"
                                        Foreground="White"
                                        Width="100"
                                        Height="35"/>
                            </Grid>
                        </Border>
                        
                        <!-- Summary Cards -->
                        <Grid ColumnDefinitions="*,*" Margin="0,0,0,15">
                            
                            <Border Grid.Column="0"
                                    Background="#27AE60"
                                    CornerRadius="8"
                                    Padding="15"
                                    Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="Total Sales"
                                               Foreground="White"
                                               FontSize="14"/>
                                    <TextBlock Text="{Binding TotalSales, StringFormat='S/ {0:F2}'}"
                                               Foreground="White"
                                               FontSize="24"
                                               FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            
                            <Border Grid.Column="1"
                                    Background="#4A90D9"
                                    CornerRadius="8"
                                    Padding="15">
                                <StackPanel>
                                    <TextBlock Text="Total Invoices"
                                               Foreground="White"
                                               FontSize="14"/>
                                    <TextBlock Text="{Binding TotalInvoices}"
                                               Foreground="White"
                                               FontSize="24"
                                               FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        
                        <!-- Sales Report Table -->
                        <Border Background="#555555"
                                CornerRadius="8"
                                Padding="15">
                            <StackPanel>
                                <TextBlock Text="📋 SALES TRANSACTIONS"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           Margin="0,0,0,10"/>
                                
                                <ScrollViewer Height="350">
                                    <ListBox ItemsSource="{Binding SalesReport}"
                                             Background="#666666">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#4A4A4A"
                                                        Margin="2"
                                                        Padding="10">
                                                    <Grid ColumnDefinitions="140,100,180,110,110,130">
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding InvoiceNumber}" 
                                                                   Foreground="#FFD700"
                                                                   FontWeight="Bold"/>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding DateFormatted}" 
                                                                   Foreground="White"/>
                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding CustomerName}" 
                                                                   Foreground="White"/>
                                                        <TextBlock Grid.Column="3"
                                                                   Text="{Binding SubtotalFormatted}" 
                                                                   Foreground="#27AE60"
                                                                   HorizontalAlignment="Right"/>
                                                        <TextBlock Grid.Column="4"
                                                                   Text="{Binding TaxFormatted}" 
                                                                   Foreground="#F39C12"
                                                                   HorizontalAlignment="Right"/>
                                                        <TextBlock Grid.Column="5"
                                                                   Text="{Binding TotalFormatted}" 
                                                                   Foreground="White"
                                                                   FontWeight="Bold"
                                                                   HorizontalAlignment="Right"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </ScrollViewer>
                                
                                <TextBlock Text="{Binding SalesReport.Count, StringFormat='Total: {0} transactions'}"
                                           Foreground="#CCCCCC"
                                           Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            
            <!-- Tab 2: Product Report -->
            <TabItem Header="📦 PRODUCT REPORT">
                <ScrollViewer>
                    <StackPanel Margin="15">
                        
                        <!-- Search Bar -->
                        <Border Background="#555555"
                                CornerRadius="8"
                                Padding="15"
                                Margin="0,0,0,15">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Grid.Column="0"
                                         Text="{Binding SearchProductName}"
                                         Watermark="Search by product name..."
                                         Background="#666666"
                                         Foreground="White"
                                         Margin="0,0,10,0"/>
                                <Button Grid.Column="1"
                                        Command="{Binding SearchProductReportCommand}"
                                        Content="SEARCH"
                                        Background="#4A90D9"
                                        Foreground="White"
                                        Width="100"/>
                            </Grid>
                        </Border>
                        
                        <!-- Product Report Table -->
                        <Border Background="#555555"
                                CornerRadius="8"
                                Padding="15">
                            <StackPanel>
                                <TextBlock Text="📋 PRODUCT INVENTORY"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           Margin="0,0,0,10"/>
                                
                                <ScrollViewer Height="450">
                                    <ListBox ItemsSource="{Binding ProductReport}"
                                             Background="#666666">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#4A4A4A"
                                                        Margin="2"
                                                        Padding="10">
                                                    <Grid ColumnDefinitions="60,220,80,110,160,160">
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding ProductId}" 
                                                                   Foreground="#CCCCCC"/>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding ProductName}" 
                                                                   Foreground="#FFD700"
                                                                   FontWeight="Bold"/>
                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding Stock}" 
                                                                   Foreground="White"
                                                                   HorizontalAlignment="Center"/>
                                                        <TextBlock Grid.Column="3"
                                                                   Text="{Binding PriceFormatted}" 
                                                                   Foreground="#27AE60"
                                                                   HorizontalAlignment="Right"/>
                                                        <TextBlock Grid.Column="4"
                                                                   Text="{Binding TotalValueFormatted}" 
                                                                   Foreground="#4A90D9"
                                                                   FontWeight="Bold"
                                                                   HorizontalAlignment="Right"/>
                                                        <TextBlock Grid.Column="5"
                                                                   Text="{Binding CategoryName}" 
                                                                   Foreground="#CCCCCC"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </ScrollViewer>
                                
                                <TextBlock Text="{Binding ProductReport.Count, StringFormat='Total: {0} products'}"
                                           Foreground="#CCCCCC"
                                           Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        
        <!-- Loading Overlay -->
        <Border Grid.Row="0" Grid.RowSpan="3"
                Background="#CC000000"
                IsVisible="{Binding IsLoading}">
            <TextBlock Text="⏳ GENERATING REPORT..."
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="Yellow"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Border>
        
    </Grid>
</UserControl>
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Sistema_Facturacion.Views.ProductView"
             Background="#2E2E2E">
    
    <ScrollViewer>
        <StackPanel Margin="20">
            
            <!-- Header -->
            <Border Background="#4A90D9"
                    CornerRadius="8"
                    Padding="15"
                    Margin="0,0,0,20">
                <TextBlock Text="📦 PRODUCT MANAGEMENT"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"/>
            </Border>
            
            <!-- Status -->
            <Border Background="#333333"
                    CornerRadius="5"
                    Padding="10"
                    Margin="0,0,0,15">
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="#FFD700"
                           FontWeight="Bold"/>
            </Border>
            
            <!-- Search -->
            <Border Background="#404040"
                    CornerRadius="8"
                    Padding="15"
                    Margin="0,0,0,15">
                <StackPanel Orientation="Horizontal">
                    <TextBox Text="{Binding SearchText}"
                             Watermark="🔍 Search products..."
                             Width="300"
                             Background="#555555"
                             Foreground="White"
                             Margin="0,0,10,0"/>
                    <Button Command="{Binding SearchCommand}"
                            Content="SEARCH"
                            Background="#4A90D9"
                            Foreground="White"
                            Width="100"
                            Margin="0,0,10,0"/>
                    <Button Command="{Binding LoadProductsCommand}"
                            Content="REFRESH"
                            Background="#4A90D9"
                            Foreground="White"
                            Width="100"/>
                </StackPanel>
            </Border>
            
            <!-- Products List -->
            <Border Background="#404040"
                    CornerRadius="8"
                    Padding="15"
                    Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="📋 PRODUCTS LIST"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,0,0,10"/>
                    
                    <ListBox ItemsSource="{Binding Products}"
                             SelectedItem="{Binding SelectedProduct}"
                             Height="300"
                             Background="#555555">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#4A4A4A"
                                        Margin="2"
                                        Padding="10">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Id}" 
                                                   Width="50" 
                                                   Foreground="White"/>
                                        <TextBlock Text="{Binding Name}" 
                                                   Width="200" 
                                                   Foreground="#FFD700"
                                                   FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Price, StringFormat='S/ {0:F2}'}" 
                                                   Width="100" 
                                                   Foreground="#27AE60"/>
                                        <TextBlock Text="{Binding Stock}" 
                                                   Width="80" 
                                                   Foreground="White"/>
                                        <TextBlock Text="{Binding CategoryName}" 
                                                   Width="150" 
                                                   Foreground="#CCCCCC"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    
                    <TextBlock Text="{Binding Products.Count, StringFormat='Total: {0} products'}"
                               Foreground="White"
                               Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
            
            <!-- Product Form -->
            <Border Background="#404040"
                    CornerRadius="8"
                    Padding="20"
                    Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="✏️ PRODUCT FORM"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,0,0,15"/>
                    
                    <Grid ColumnDefinitions="100,*,100,*" RowDefinitions="Auto,Auto,Auto"
                          Margin="0,0,0,10">
                        
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="Name:" 
                                   Foreground="White" 
                                   VerticalAlignment="Center"
                                   Margin="0,10,10,10"/>
                        <TextBox Grid.Row="0" Grid.Column="1"
                                 Text="{Binding Name}"
                                 Watermark="Product name"
                                 Background="#555555"
                                 Foreground="White"
                                 Margin="0,10,20,10"
                                 Height="35"/>
                        
                        <TextBlock Grid.Row="0" Grid.Column="2"
                                   Text="Price:" 
                                   Foreground="White" 
                                   VerticalAlignment="Center"
                                   Margin="0,10,10,10"/>
                        <TextBox Grid.Row="0" Grid.Column="3"
                                 Text="{Binding Price}"
                                 Watermark="0.00"
                                 Background="#555555"
                                 Foreground="White"
                                 Margin="0,10,0,10"
                                 Height="35"/>
                    </Grid>
                    
                    <Grid ColumnDefinitions="100,*,100,*" Margin="0,0,0,10">
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="Stock:" 
                                   Foreground="White" 
                                   VerticalAlignment="Center"
                                   Margin="0,5,10,5"/>
                        <TextBox Grid.Row="0" Grid.Column="1"
                                 Text="{Binding Stock}"
                                 Watermark="Quantity"
                                 Background="#555555"
                                 Foreground="White"
                                 Margin="0,5,20,5"
                                 Height="35"/>
                        
                        <TextBlock Grid.Row="0" Grid.Column="2"
                                   Text="Category:" 
                                   Foreground="White" 
                                   VerticalAlignment="Center"
                                   Margin="0,5,10,5"/>
                        <ComboBox Grid.Row="0" Grid.Column="3"
                                  ItemsSource="{Binding Categories}"
                                  SelectedItem="{Binding SelectedCategory}"
                                  Background="#555555"
                                  Foreground="White"
                                  Margin="0,5,0,5"
                                  Height="35">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Foreground="White"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                    
                    <Grid ColumnDefinitions="100,*" Margin="0,0,0,10">
                        <TextBlock Grid.Column="0"
                                   Text="Description:" 
                                   Foreground="White" 
                                   VerticalAlignment="Top"
                                   Margin="0,5,10,5"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding Description}"
                                 Watermark="Product description"
                                 Background="#555555"
                                 Foreground="White"
                                 Margin="0,5,0,5"
                                 Height="60"
                                 AcceptsReturn="True"/>
                    </Grid>
                    
                    <StackPanel Orientation="Horizontal" 
                                Margin="0,20,0,0"
                                HorizontalAlignment="Center"
                                Spacing="10">
                        <Button Command="{Binding SaveCommand}"
                                Content="💾 SAVE"
                                Background="#27AE60"
                                Foreground="White"
                                Width="100"
                                Height="40"/>
                        <Button Command="{Binding UpdateCommand}"
                                Content="✏️ UPDATE"
                                Background="#F39C12"
                                Foreground="White"
                                Width="100"
                                Height="40"/>
                        <Button Command="{Binding DeleteCommand}"
                                Content="🗑️ DELETE"
                                Background="#E74C3C"
                                Foreground="White"
                                Width="100"
                                Height="40"/>
                        <Button Command="{Binding ClearFormCommand}"
                                Content="🗑️ CLEAR"
                                Background="#95A5A6"
                                Foreground="White"
                                Width="100"
                                Height="40"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
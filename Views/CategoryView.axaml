<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Sistema_Facturacion.Views.CategoryView"
             Background="#2E2E2E">
    
    <ScrollViewer>
        <StackPanel Margin="20">
            
            
            <!-- Header visible -->
            <Border Background="#4A90D9"
                    CornerRadius="8"
                    Padding="15"
                    Margin="0,0,0,20">
                <TextBlock Text="📁 CATEGORY MANAGEMENT"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"/>
            </Border>
            
            <!-- Status Message -->
            <Border Background="#333333"
                    CornerRadius="5"
                    Padding="10"
                    Margin="0,0,0,15">
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="#FFD700"
                           FontWeight="Bold"/>
            </Border>
            
            <!-- Search Bar -->
            <Border Background="#404040"
                    CornerRadius="8"
                    Padding="15"
                    Margin="0,0,0,15">
                <StackPanel Orientation="Horizontal">
                    <TextBox Text="{Binding SearchText}"
                             Watermark="🔍 Search categories..."
                             Width="300"
                             Background="#555555"
                             Foreground="White"
                             Margin="0,0,10,0"/>
                    <Button Command="{Binding SearchCommand}"
                            Content="SEARCH"
                            Background="#4A90D9"
                            Foreground="White"
                            Width="100"
                            Margin="0,0,10,0"/>
                    <Button Command="{Binding LoadCategoriesCommand}"
                            Content="REFRESH"
                            Background="#4A90D9"
                            Foreground="White"
                            Width="100"/>
                </StackPanel>
            </Border>
            
            <!-- Categories List - Version simplificada con ListBox -->
            <Border Background="#404040"
                    CornerRadius="8"
                    Padding="15"
                    Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="📋 CATEGORIES LIST"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,0,0,10"/>
        
                    <!-- Usar ListBox en lugar de DataGrid para probar -->
                    <ListBox ItemsSource="{Binding Categories}"
                             SelectedItem="{Binding SelectedCategory}"
                             Height="300"
                             Background="#555555">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#4A4A4A"
                                        Margin="2"
                                        Padding="10">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Id}" 
                                                   Width="50" 
                                                   Foreground="White"/>
                                        <TextBlock Text="{Binding Name}" 
                                                   Width="200" 
                                                   Foreground="White"
                                                   FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Description}" 
                                                   Width="300" 
                                                   Foreground="#CCCCCC"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
        
                    <!-- Mostrar cantidad -->
                    <TextBlock Text="{Binding Categories.Count, StringFormat='Total: {0} categories'}"
                               Foreground="White"
                               Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
            
            <!-- Form -->
            <Border Background="#404040"
                    CornerRadius="8"
                    Padding="15"
                    Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="✏️ CATEGORY FORM"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,0,0,10"/>
                    
                    <TextBlock Text="Name:" Foreground="White" Margin="0,5"/>
                    <TextBox Text="{Binding CategoryName}"
                             Watermark="Category name"
                             Background="#555555"
                             Foreground="White"
                             Margin="0,5"/>
                    
                    <TextBlock Text="Description:" Foreground="White" Margin="0,15,0,5"/>
                    <TextBox Text="{Binding CategoryDescription}"
                             Watermark="Optional description"
                             AcceptsReturn="True"
                             Height="80"
                             Background="#555555"
                             Foreground="White"
                             Margin="0,5"/>
                    
                    <StackPanel Orientation="Horizontal" 
                                Margin="0,20,0,0"
                                HorizontalAlignment="Center">
                        <Button Command="{Binding SaveCommand}"
                                Content="💾 SAVE"
                                Background="#27AE60"
                                Foreground="White"
                                Width="90"
                                Margin="0,0,10,0"/>
                        <Button Command="{Binding UpdateCommand}"
                                Content="✏️ UPDATE"
                                Background="#F39C12"
                                Foreground="White"
                                Width="90"
                                Margin="0,0,10,0"/>
                        <Button Command="{Binding DeleteCommand}"
                                Content="🗑️ DELETE"
                                Background="#E74C3C"
                                Foreground="White"
                                Width="90"
                                Margin="0,0,10,0"/>
                        <Button Command="{Binding ClearFormCommand}"
                                Content="🗑️ CLEAR"
                                Background="#95A5A6"
                                Foreground="White"
                                Width="90"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Sistema_Facturacion.Views.SaleView"
             Background="#2E2E2E">
    
    <Grid RowDefinitions="Auto,Auto,*,Auto">
        
        <!-- Header -->
        <Border Grid.Row="0"
                Background="#4A90D9"
                CornerRadius="8"
                Padding="15"
                Margin="10,10,10,10">
            <TextBlock Text="🧾 NEW SALE / INVOICE"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"/>
        </Border>
        
        <!-- Status -->
        <Border Grid.Row="1"
                Background="#333333"
                CornerRadius="5"
                Padding="10"
                Margin="10,0,10,10">
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="#FFD700"
                       FontWeight="Bold"/>
        </Border>
        
        <!-- Main Content -->
        <Grid Grid.Row="2"
              Margin="10">
            
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Left Panel - Customer & Product Selection -->
            <Border Grid.Column="0"
                    Background="#404040"
                    CornerRadius="8"
                    Padding="15"
                    Margin="0,0,10,0">
                <StackPanel>
                    
                    <!-- Customer Selection -->
                    <TextBlock Text="👤 SELECT CUSTOMER"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,0,0,10"/>
                    
                    <ComboBox ItemsSource="{Binding Customers}"
                              SelectedItem="{Binding SelectedCustomer}"
                              Background="#555555"
                              Foreground="White"
                              Height="35"
                              Margin="0,0,0,15">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" Foreground="White"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    
                    <!-- Product Search -->
                    <TextBlock Text="🔍 SEARCH PRODUCT"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,10,0,10"/>
                    
                    <TextBox Text="{Binding SearchProductText}"
                             Watermark="Search by name..."
                             Background="#555555"
                             Foreground="White"
                             Height="35"
                             Margin="0,0,0,10"/>
                    
                    <Button Command="{Binding SearchProductCommand}"
                            Content="SEARCH"
                            Background="#4A90D9"
                            Foreground="White"
                            Height="35"
                            Margin="0,0,0,15"/>
                    
                    <!-- Products List -->
                    <TextBlock Text="📋 PRODUCTS"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,0,0,5"/>
                    
                    <ListBox ItemsSource="{Binding Products}"
                             SelectedItem="{Binding SelectedProduct}"
                             Height="200"
                             Background="#555555">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#4A4A4A"
                                        Margin="2"
                                        Padding="8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" 
                                                   Width="150" 
                                                   Foreground="#FFD700"
                                                   FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Price, StringFormat='S/ {0:F2}'}" 
                                                   Width="80" 
                                                   Foreground="#27AE60"/>
                                        <TextBlock Text="Stock:" 
                                                   Foreground="#CCCCCC"/>
                                        <TextBlock Text="{Binding Stock}" 
                                                   Width="50" 
                                                   Foreground="White"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    
                    <!-- Stock info -->
                    <TextBlock Text="{Binding SelectedProduct.Stock, StringFormat='Stock available: {0} units'}"
                               Foreground="#FFD700"
                               Margin="0,5,0,0"/>
                    
                    <!-- Quantity -->
                    <TextBlock Text="🔢 QUANTITY"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,15,0,5"/>
                    
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Grid.Column="0"
                                 Text="{Binding Quantity}"
                                 Background="#555555"
                                 Foreground="White"
                                 Height="35"/>
                        <Button Grid.Column="1"
                                Command="{Binding AddToCartCommand}"
                                Content="➕ ADD"
                                Background="#27AE60"
                                Foreground="White"
                                Width="80"
                                Height="35"
                                Margin="10,0,0,0"/>
                    </Grid>
                    
                </StackPanel>
            </Border>
            
            <!-- Right Panel - Cart -->
            <Border Grid.Column="1"
                    Background="#404040"
                    CornerRadius="8"
                    Padding="15">
                <StackPanel>
                    
                    <TextBlock Text="🛒 SHOPPING CART"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,0,0,10"/>
                    
                    <!-- Cart Items -->
                    <ListBox ItemsSource="{Binding Cart}"
                             SelectedItem="{Binding SelectedCartItem}"
                             Height="250"
                             Background="#555555">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#4A4A4A"
                                        Margin="2"
                                        Padding="8">
                                    <Grid ColumnDefinitions="2*,*,*,Auto">
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Product.Name}" 
                                                   Foreground="#FFD700"
                                                   FontWeight="Bold"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Quantity}" 
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding UnitPrice, StringFormat='S/ {0:F2}'}" 
                                                   Foreground="#27AE60"
                                                   HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding Subtotal, StringFormat='S/ {0:F2}'}" 
                                                   Foreground="White"
                                                   HorizontalAlignment="Right"
                                                   Margin="10,0,0,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    
                    <Button Command="{Binding RemoveFromCartCommand}"
                            Content="🗑️ REMOVE SELECTED"
                            Background="#E74C3C"
                            Foreground="White"
                            Height="35"
                            Margin="0,10,0,15"/>
                    
                    <!-- Totals -->
                    <Border Background="#2E2E2E"
                            CornerRadius="5"
                            Padding="15"
                            Margin="0,10,0,0">
                        <StackPanel>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Subtotal:" Foreground="#CCCCCC"/>
                                <TextBlock Grid.Column="1" Text="{Binding Subtotal, StringFormat='S/ {0:F2}'}" 
                                           Foreground="White" FontWeight="Bold"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" Margin="0,5,0,0">
                                <TextBlock Grid.Column="0" Text="IGV (18%):" Foreground="#CCCCCC"/>
                                <TextBlock Grid.Column="1" Text="{Binding Tax, StringFormat='S/ {0:F2}'}" 
                                           Foreground="White"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" Margin="0,10,0,0">
                                <TextBlock Grid.Column="0" Text="TOTAL:" Foreground="#FFD700" FontWeight="Bold"/>
                                <TextBlock Grid.Column="1" Text="{Binding Total, StringFormat='S/ {0:F2}'}" 
                                           Foreground="#27AE60" FontSize="18" FontWeight="Bold"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    
                    <!-- Process Button -->
                    <Button Command="{Binding ProcessSaleCommand}"
                            Content="✅ PROCESS SALE / GENERATE INVOICE"
                            Background="#27AE60"
                            Foreground="White"
                            Height="45"
                            FontWeight="Bold"
                            Margin="0,15,0,0"/>
                    
                    <Button Command="{Binding ClearSaleCommand}"
                            Content="🗑️ CLEAR SALE"
                            Background="#95A5A6"
                            Foreground="White"
                            Height="35"
                            Margin="0,10,0,0"/>
                    
                </StackPanel>
            </Border>
        </Grid>
        
        <!-- Loading Overlay -->
        <Border Grid.Row="0" Grid.RowSpan="4"
                Background="#CC000000"
                IsVisible="{Binding IsLoading}">
            <TextBlock Text="⏳ PROCESSING..."
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="Yellow"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Border>
        
    </Grid>
</UserControl>